{
  "name": "orgtik-website-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Website Manager: the CMS for the OrgTik website, with its demo backend built in.",
  "scripts": {
    "dev": "node tools/link-backend.cjs && next dev -p 3007",
    "build": "node tools/link-backend.cjs && next build",
    "start": "next start -p 3007",
    "typecheck": "node tools/next-env.cjs && tsc --noEmit",
    "i18n:check": "node tools/i18n/check-catalogs.mjs",
    "test": "node --experimental-strip-types --test lib/richCopy.test.mjs lib/centralUsers.test.mjs lib/legacyStringLabels.test.mjs lib/caseFormatLabels.test.cjs lib/editorSectionOrder.test.cjs lib/pageCardGroups.test.cjs lib/pagePreview.test.cjs lib/pagePlacement.test.cjs",
    "backend": "node tools/link-backend.cjs"
  },
