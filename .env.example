# Copy to .env.local for local development. All values are optional locally.

# The public website (preview frames, media).
NEXT_PUBLIC_WEBSITE_URL=http://localhost:4173

# This app's public address, if not the Vercel production domain (e.g. a custom domain).
# WM_PUBLIC_URL=https://cms.example.com

# Durable data (optional, otherwise demo mode). Upstash Redis via the Vercel integration:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# MOCK_SESSION_SECRET=   # 32+ random characters
